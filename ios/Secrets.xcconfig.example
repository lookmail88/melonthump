// Copy this file to Secrets.xcconfig (same folder) and uncomment the
// two lines with the real AdMob IDs from the AdMob console.
// Secrets.xcconfig is gitignored — real IDs never enter the repository,
// and nobody needs to send them anywhere: they only live on this machine.

// ADMOB_APP_ID = ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
// ADMOB_REWARDED_UNIT_ID = ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
